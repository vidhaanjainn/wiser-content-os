# Copy this file to .env and fill in your values
# NEVER commit .env to GitHub — it's already in .gitignore

# Web app URL from Apps Script Deploy (see apps-script/Code.gs)
VITE_SHEETS_API_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
# Must match the API_TOKEN constant set in apps-script/Code.gs
VITE_SHEETS_API_TOKEN=your-long-random-token
